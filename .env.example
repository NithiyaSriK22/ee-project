# MediKiosk - Environment Configuration Template
# Copy to .env and configure appropriate values for your environment.

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000/api/v1
LOG_LEVEL=info

# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================================================================
DATABASE_URL=postgresql://medikiosk_user:medikiosk_password@localhost:5432/medikiosk_db?schema=public

# ==============================================================================
# CORS & FRONTEND CLIENT URLS
# ==============================================================================
KIOSK_FRONTEND_URL=http://localhost:5173
DOCTOR_PORTAL_FRONTEND_URL=http://localhost:5174

# ==============================================================================
# SECURITY & AUTHENTICATION (Secret tokens - never commit production secrets)
# ==============================================================================
JWT_SECRET=development_jwt_secret_must_be_at_least_32_chars_long_medikiosk
JWT_EXPIRES_IN=15m

REFRESH_TOKEN_SECRET=development_refresh_token_secret_medikiosk_32_chars_minimum
REFRESH_TOKEN_EXPIRES_IN=7d

KIOSK_SESSION_SECRET=development_kiosk_session_secret_medikiosk_32_chars_minimum
KIOSK_SESSION_EXPIRES_IN=1h

PASSWORD_RESET_TOKEN_EXPIRES_IN=1h
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=24h

# ==============================================================================
# RATE LIMITING
# ==============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
