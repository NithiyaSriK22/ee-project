{
  "name": "medikiosk-root",
  "version": "1.0.0",
  "description": "MEDBRIEF — Medical Intelligence. Simplified. (SIH26047)",
  "private": true,
  "workspaces": [
    "backend",
    "frontend-kiosk",
    "frontend-doctor-portal"
  ],
  "scripts": {
    "db:start": "npm --workspace=backend run db:start",
    "db:ready": "npm --workspace=backend run db:ready",
    "db:push": "npm --workspace=backend run db:push",
    "prisma:generate": "npm --workspace=backend run prisma:generate",
    "dev:backend": "npm --workspace=backend run dev",
    "dev:kiosk": "npm --workspace=frontend-kiosk run dev",
    "dev:doctor": "npm --workspace=frontend-doctor-portal run dev",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces"
  },
  "prisma": {
    "schema": "backend/prisma/schema.prisma"
  },
  "keywords": [
    "medikiosk",
    "healthcare",
    "clinical-intake",
    "doctor-summary",
    "triage"
  ],
  "author": "MEDBRIEF Engineering Team",
  "license": "UNLICENSED"
}
